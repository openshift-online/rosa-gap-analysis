#!/usr/bin/env bash
# Optional git hook wrapper. Prefer `pre-commit install` (see .pre-commit-config.yaml).
# If the framework is not installed, fall back to `make lint` (the Prow target).

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "ERROR: Not in a git repository" >&2
    exit 1
}
cd "${REPO_ROOT}"

if command -v pre-commit >/dev/null 2>&1; then
    exec pre-commit run
fi

echo "pre-commit not installed; running make lint" >&2
exec make lint
